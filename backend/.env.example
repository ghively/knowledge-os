# Knowledge OS Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_ENABLED=true

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLIP_MODEL=openai/clip-vit-base-patch32

# File Watcher
MAX_FILE_SIZE_MB=50

# Backup
BACKUP_ENABLED=true
SNAPSHOT_INTERVAL_HOURS=24
MARKDOWN_EXPORT_ENABLED=true
MARKDOWN_EXPORT_PATH=./backups/markdown
MARKDOWN_EXPORT_INTERVAL_HOURS=168
GIT_BACKUP_ENABLED=false
GIT_REPO_PATH=./backups/git
GIT_REMOTE_URL=

# Context Builder
MAX_CONTEXT_TOKENS=4000
CONTEXT_CHUNK_SIZE=1000
